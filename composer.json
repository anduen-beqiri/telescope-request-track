{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bekand/telescope-request-track",
    "description": "Automatically attach request identifiers to Laravel JSON responses and Telescope request entries.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "telescope",
        "request",
        "middleware",
        "request-id"
    ],
    "authors": [
        {
            "name": "Bek And",
            "email": "anduenbeqirii@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "BekAnd\\TelescopeRequestTrack\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BekAnd\\TelescopeRequestTrack\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BekAnd\\TelescopeRequestTrack\\TelescopeRequestTrackServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}